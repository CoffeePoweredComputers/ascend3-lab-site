# Copy to transcript-drop/.env on the server (chmod 600). Never commit it.
# Read at startup by app/config.py; systemd also passes it to the unit, and the
# real environment always wins over this file.

# nginx proxies /transcript-drop/ to this port on loopback. 8787 is the survey
# service; keep them apart.
PORT=8788

# ---- Sign-in (required) ----------------------------------------------------
# Students sign in with a VT Google account and the server verifies the Firebase
# ID token. All four values are public -- a Firebase web apiKey names a project,
# it does not authorise anything -- and there is no service-account key, because
# checking a signature needs Google's public keys, not the project's private one.
#
# Firebase console -> Project settings -> Your apps -> SDK setup and configuration.
# Then Authentication -> Settings -> Authorized domains must list ascend3.cs.vt.edu,
# or the sign-in popup fails, and fails quietly.
#
# All four must be set. With any missing, the server treats sign-in as
# unconfigured, says so on the page, and refuses every request. It never falls
# back to trusting a typed address.
GENAI_FIREBASE_API_KEY=
GENAI_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
GENAI_FIREBASE_PROJECT_ID=your-project
GENAI_FIREBASE_APP_ID=

# ---- Admin status endpoint -------------------------------------------------
# Guards /api/admin/status, which reports submission counts. Generate with
# `openssl rand -base64 32`. Unset, that endpoint answers 503 rather than opening.
GENAI_ADMIN_TOKEN=

# ---- Backups ---------------------------------------------------------------
# Where deploy/ascend-transcript-drop-backup.timer writes nightly. Must exist and
# be writable by the deploying user.
#
# This is on the same disk as the databases, which means it survives a mistake
# but not a lost machine. Point it at research storage as soon as there is some.
BACKUP_DEST=/home/CHANGE_ME/transcript-drop-backups
