# Build
dist/
.astro/

# Test/automation artifacts
.playwright-mcp/

# Dependencies
node_modules/

# Firebase
firebase-debug.log
.firebase/

# Environment
.env
.env.*

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
# LibreOffice lock files (appear while a .xlsx template is open)
.~lock.*#

# OS
.DS_Store
Thumbs.db

# Survey service (survey/): keep the committed example, ignore real env + build output
!survey/.env.example
survey/dist/

# Transcript submission service (transcript-drop/). It carries its own
# .gitignore, which is what actually protects the student data inside it — the
# roster, the consent file and the SQLite databases. These lines are the
# belt-and-braces copy at the root, where they are visible to anyone auditing
# what this public repository can and cannot contain.
!transcript-drop/.env.example
transcript-drop/.venv/
transcript-drop/data/
transcript-drop/config/roster.csv
transcript-drop/config/consent.csv

# Lab tools (tools/<name>/): each is built into a container from its own
# directory, so nothing installed locally while developing one belongs here.
# Runtime state (data, secrets, status) lives outside the checkout entirely.
tools/*/data/
tools/*/.venv/
tools/*/node_modules/
!tools/*/.env.example
