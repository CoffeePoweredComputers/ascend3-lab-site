# Copy to survey/.env on the server (chmod 600). Never commit survey/.env.
# Everything here is read by src/env.ts at startup; missing required values abort boot.

NODE_ENV=production
PORT=8787
# Public URL the service is reachable at (nginx proxies /survey/ to 127.0.0.1:$PORT).
BASE_URL=https://ascend3.cs.vt.edu/survey

# VT CAS (no service registration needed for *.vt.edu hosts).
CAS_BASE_URL=https://login.vt.edu/profile/cas

# 32+ random bytes, e.g. `openssl rand -hex 32`. Rotating it signs everyone out.
SESSION_SECRET=

# LLM. `arc` = Virginia Tech ARC on-prem service (the only provider allowed by IRB #26-817).
# `mock` = deterministic offline probes for local development and tests.
LLM_PROVIDER=arc
ARC_LLM_BASE_URL=https://llm-api.arc.vt.edu/api/v1
ARC_LLM_API_KEY=

# Postgres. Two app roles that cannot see each other's schema, plus the owner used only by migrations.
SURVEY_DATABASE_URL=postgresql://survey_app:CHANGE_ME@127.0.0.1:5432/ascend_survey
KEYRING_DATABASE_URL=postgresql://keyring_app:CHANGE_ME@127.0.0.1:5432/ascend_survey
MIGRATE_DATABASE_URL=postgresql://survey_owner:CHANGE_ME@127.0.0.1:5432/ascend_survey

# Local development only. Ignored unless NODE_ENV != production AND the request comes from loopback.
DEV_LOGIN_ENABLED=0
