---
/**
 * WikiSidebar — Khan-Academy style module → lesson navigation.
 *
 * Sibling to Navigation.astro (the homepage scroll-trail). This one is built for
 * a MULTI-PAGE section: active state comes from the current URL.
 *
 * Collapsible modules use native <details>; the active module is open by default.
 */
import { getWikiNav, lessonHref } from '../lib/wiki';
import AuthWidget from './AuthWidget.astro';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import tools from '../data/wiki-tools.json';

const nav = await getWikiNav();
const stripSlash = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const current = stripSlash(Astro.url.pathname);

const isActiveLesson = (l: (typeof nav)[number]['lessons'][number]) =>
  stripSlash(lessonHref(l)) === current;
const isActiveModule = (m: (typeof nav)[number]) => m.lessons.some(isActiveLesson);
---

<!-- ═══ DESKTOP SIDEBAR ═══ -->
<aside class="hidden lg:flex fixed left-0 top-0 bottom-0 w-[340px] z-40 flex-col" aria-label="Lab wiki navigation">
  <div class="absolute inset-0 bg-white/60 dark:bg-surface-base/60 backdrop-blur-xl border-r border-border/50"></div>
  <div class="absolute inset-0 topo-sidebar opacity-30 pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col h-full px-6 py-6">
    <!-- Header -->
    <div class="shrink-0 mb-5">
      <a href="/" class="no-underline text-xs font-mono text-text-muted hover:text-primary">← ASCEND Lab</a>
      <a href="/wiki" class="no-underline block group">
        <h2 class="mt-2 font-heading text-xl font-bold text-text group-hover:text-primary transition-colors">Lab Wiki</h2>
        <p class="text-xs text-text-muted">Interactive lab handbook</p>
      </a>
    </div>

    <!-- Modules -->
    <nav class="flex-1 min-h-0 overflow-y-auto wiki-sidebar__scroll" aria-label="Modules">
      {nav.map((m) => (
        m.underConstruction ? (
          <div class="wiki-mod wiki-mod--soon" data-mod={m.slug}>
            <div class="wiki-mod__summary wiki-mod__summary--soon">
              <span class="wiki-mod__icon" aria-hidden="true">{m.icon}</span>
              <span class="wiki-mod__title">{m.title}</span>
              <span class="wiki-mod__soon">🚧 Soon</span>
            </div>
          </div>
        ) : (
          <details class="wiki-mod" data-mod={m.slug} open={isActiveModule(m)}>
            <summary class="wiki-mod__summary">
              <span class="wiki-mod__icon" aria-hidden="true">{m.icon}</span>
              <span class="wiki-mod__title">{m.title}</span>
            </summary>
            <ul class="wiki-mod__lessons" role="list">
              {m.items.map((item) => (
                item.kind === 'lesson' ? (
                  <li>
                    <a
                      href={lessonHref(item.lesson)}
                      class="wiki-lesson no-underline"
                      aria-current={isActiveLesson(item.lesson) ? 'page' : undefined}
                    >
                      <span class="wiki-lesson__title">{item.lesson.data.title}</span>
                    </a>
                  </li>
                ) : (
                  <li>
                    <details class="wiki-subgroup" open={item.lessons.some((l) => isActiveLesson(l))}>
                      <summary class="wiki-subgroup__summary">
                        <span class="wiki-subgroup__label">{item.label}</span>
                      </summary>
                      <ul class="wiki-subgroup__lessons" role="list">
                        {item.lessons.map((l) => (
                          <li>
                            <a
                              href={lessonHref(l)}
                              class="wiki-lesson wiki-lesson--nested no-underline"
                              aria-current={isActiveLesson(l) ? 'page' : undefined}
                            >
                              <span class="wiki-lesson__title">{l.data.title}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                )
              ))}
            </ul>
          </details>
        )
      ))}

      <!-- Research tools — standalone utility pages, open to everyone -->
      <div class="wiki-tools">
        <p class="wiki-tools__label">Research tools</p>
        {tools.map((t) => (
          <a href={t.href} class="wiki-tool no-underline" aria-current={current === t.href ? 'page' : undefined}>
            <span class="wiki-mod__icon" aria-hidden="true">{t.icon}</span>
            <span class="wiki-tool__title">{t.title}</span>
          </a>
        ))}
      </div>
    </nav>

    <!-- Sign in / membership -->
    <div class="shrink-0 pt-4 mt-2 border-t border-border/50">
      <AuthWidget>
        <nav slot="menu" class="wiki-auth__menu" aria-label="Account">
          <a class="wiki-auth__item wiki-auth__item--editor" data-auth-propose href="/wiki/new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            <span>Propose content</span>
          </a>
          <a class="wiki-auth__item" data-auth-myreports href="/wiki/my-reports">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            <span>My reports</span>
          </a>
          <a class="wiki-auth__item wiki-auth__item--admin" data-auth-wikiadmin href="/wiki/admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.5 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.5"/></svg>
            <span>Wiki admin</span>
          </a>
          <a class="wiki-auth__item wiki-auth__item--admin" data-auth-siteadmin href="/admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/></svg>
            <span>Site admin</span>
          </a>
        </nav>
      </AuthWidget>
    </div>

    <!-- Footer -->
    <div class="shrink-0 pt-4 border-t border-border/50 flex items-center justify-between">
      <p class="text-[11px] text-text-muted/60 leading-relaxed">Virginia Tech<br/>Dept. of Computer Science</p>
      <button type="button" id="wiki-theme-toggle" class="theme-toggle p-2 rounded-md text-text-muted hover:text-text hover:bg-surface" aria-label="Toggle dark mode">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="1.75em" height="1.75em" fill="currentColor" stroke-linecap="round" class="theme-toggle__classic" viewBox="0 0 32 32">
          <clipPath id="wiki-cutout-d"><path d="M0-5h30a1 1 0 0 0 9 13v24H0Z" /></clipPath>
          <g clip-path="url(#wiki-cutout-d)">
            <circle cx="16" cy="16" r="9.34" />
            <g stroke="currentColor" stroke-width="1.5">
              <path d="M16 5.5v-4" /><path d="M16 30.5v-4" /><path d="M1.5 16h4" /><path d="M26.5 16h4" />
              <path d="m23.4 8.6 2.8-2.8" /><path d="m5.7 26.3 2.9-2.9" /><path d="m5.8 5.8 2.8 2.8" /><path d="m23.4 23.4 2.9 2.9" />
            </g>
          </g>
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- ═══ DESKTOP COMMAND BAR ═══ -->
<!-- VS Code-style Command Center: a slim fixed bar over the content area with
     one centered pill. The palette drops top-aligned over it (see wiki.css),
     so the pill reads as expanding into the palette. Plain <div>: the mobile
     <header> below is the page's banner landmark; this holds a lone button. -->
<div class="hidden lg:flex fixed top-0 left-[340px] right-0 z-30 h-14 items-center justify-center bg-white/60 dark:bg-surface-base/60 backdrop-blur-xl border-b border-border/50">
  <!-- Mirrors .wiki-article (max-width 64rem + 1.5rem inline padding) so the
       search field's edges line up with the lesson column beneath it. -->
  <div class="wiki-search w-full max-w-5xl px-6">
    <pagefind-modal-trigger instance="wiki-search" placeholder="Search the wiki"></pagefind-modal-trigger>
  </div>
</div>

<!-- ═══ MOBILE TOP BAR ═══ -->
<header class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-white/70 dark:bg-surface-base/70 backdrop-blur-xl border-b border-border/50">
  <div class="flex items-center justify-between px-4 py-3">
    <a href="/wiki" class="no-underline font-heading font-bold text-text">Lab Wiki</a>
    <div class="flex items-center gap-1">
      <span class="wiki-search wiki-search--icon">
        <pagefind-modal-trigger instance="wiki-search" compact hide-shortcut placeholder="Search the wiki"></pagefind-modal-trigger>
      </span>
      <button type="button" id="wiki-theme-toggle-mobile" class="theme-toggle p-2 rounded-md text-text-muted hover:text-text hover:bg-surface" aria-label="Toggle dark mode">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="1.75em" height="1.75em" fill="currentColor" stroke-linecap="round" class="theme-toggle__classic" viewBox="0 0 32 32">
          <clipPath id="wiki-cutout-m"><path d="M0-5h30a1 1 0 0 0 9 13v24H0Z" /></clipPath>
          <g clip-path="url(#wiki-cutout-m)">
            <circle cx="16" cy="16" r="9.34" />
            <g stroke="currentColor" stroke-width="1.5">
              <path d="M16 5.5v-4" /><path d="M16 30.5v-4" /><path d="M1.5 16h4" /><path d="M26.5 16h4" />
              <path d="m23.4 8.6 2.8-2.8" /><path d="m5.7 26.3 2.9-2.9" /><path d="m5.8 5.8 2.8 2.8" /><path d="m23.4 23.4 2.9 2.9" />
            </g>
          </g>
        </svg>
      </button>
      <button type="button" id="wiki-menu-button" class="p-2 rounded-md text-text-muted hover:text-text hover:bg-surface" aria-expanded="false" aria-controls="wiki-mobile-menu" aria-label="Open wiki menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" class="menu-icon"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="close-icon hidden"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="wiki-mobile-menu" class="hidden max-h-[70vh] overflow-y-auto pb-4 px-4">
    <div class="py-3 mb-2 border-b border-border/50">
      <AuthWidget>
        <nav slot="menu" class="wiki-auth__menu" aria-label="Account">
          <a class="wiki-auth__item wiki-auth__item--editor" data-auth-propose href="/wiki/new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            <span>Propose content</span>
          </a>
          <a class="wiki-auth__item" data-auth-myreports href="/wiki/my-reports">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            <span>My reports</span>
          </a>
          <a class="wiki-auth__item wiki-auth__item--admin" data-auth-wikiadmin href="/wiki/admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.5 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.5"/></svg>
            <span>Wiki admin</span>
          </a>
          <a class="wiki-auth__item wiki-auth__item--admin" data-auth-siteadmin href="/admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/></svg>
            <span>Site admin</span>
          </a>
        </nav>
      </AuthWidget>
    </div>
    {nav.map((m) => (
      m.underConstruction ? (
        <div class="wiki-mod wiki-mod--soon" data-mod={m.slug}>
          <div class="wiki-mod__summary wiki-mod__summary--soon">
            <span class="wiki-mod__icon" aria-hidden="true">{m.icon}</span>
            <span class="wiki-mod__title">{m.title}</span>
            <span class="wiki-mod__soon">🚧 Soon</span>
          </div>
        </div>
      ) : (
        <details class="wiki-mod" data-mod={m.slug} open={isActiveModule(m)}>
          <summary class="wiki-mod__summary">
            <span class="wiki-mod__icon" aria-hidden="true">{m.icon}</span>
            <span class="wiki-mod__title">{m.title}</span>
          </summary>
          <ul class="wiki-mod__lessons" role="list">
            {m.items.map((item) => (
              item.kind === 'lesson' ? (
                <li>
                  <a href={lessonHref(item.lesson)} class="wiki-lesson no-underline" aria-current={isActiveLesson(item.lesson) ? 'page' : undefined}>
                    <span class="wiki-lesson__title">{item.lesson.data.title}</span>
                  </a>
                </li>
              ) : (
                <li>
                  <details class="wiki-subgroup" open={item.lessons.some((l) => isActiveLesson(l))}>
                    <summary class="wiki-subgroup__summary"><span class="wiki-subgroup__label">{item.label}</span></summary>
                    <ul class="wiki-subgroup__lessons" role="list">
                      {item.lessons.map((l) => (
                        <li>
                          <a href={lessonHref(l)} class="wiki-lesson wiki-lesson--nested no-underline" aria-current={isActiveLesson(l) ? 'page' : undefined}>
                            <span class="wiki-lesson__title">{l.data.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              )
            ))}
          </ul>
        </details>
      )
    ))}

    <!-- Research tools — standalone utility pages, open to everyone -->
    <div class="wiki-tools">
      <p class="wiki-tools__label">Research tools</p>
      {tools.map((t) => (
        <a href={t.href} class="wiki-tool no-underline" aria-current={current === t.href ? 'page' : undefined}>
          <span class="wiki-mod__icon" aria-hidden="true">{t.icon}</span>
          <span class="wiki-tool__title">{t.title}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<!-- ═══ SEARCH PALETTE ═══ -->
<!-- One modal serves both triggers (desktop sidebar + mobile top bar): the
     native <dialog> renders in the browser's top layer, above everything.
     Styled as a VS Code-style quick-open palette (top-anchored, no backdrop
     dim — see .wiki-search in wiki.css). Children are given explicitly to
     omit the keyboard-hints footer the childless modal would self-compose. -->
<div class="wiki-search">
  <PagefindConfig instance="wiki-search" />
  <pagefind-modal instance="wiki-search">
    <pagefind-modal-header>
      <pagefind-input instance="wiki-search" placeholder="Search the wiki"></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary instance="wiki-search"></pagefind-summary>
      <pagefind-results instance="wiki-search"></pagefind-results>
    </pagefind-modal-body>
  </pagefind-modal>
</div>

<script>
  // ── Mobile menu ──
  const menuBtn = document.getElementById('wiki-menu-button');
  const menu = document.getElementById('wiki-mobile-menu');
  const menuIcon = menuBtn?.querySelector('.menu-icon');
  const closeIcon = menuBtn?.querySelector('.close-icon');

  function toggleMenu() {
    const expanded = menuBtn!.getAttribute('aria-expanded') === 'true';
    menuBtn!.setAttribute('aria-expanded', String(!expanded));
    menuBtn!.setAttribute('aria-label', expanded ? 'Open wiki menu' : 'Close wiki menu');
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }
  menuBtn?.addEventListener('click', toggleMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) toggleMenu();
  });

  // ── Dark mode toggle (mirrors Navigation.astro) ──
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const toggleButtons = document.querySelectorAll<HTMLElement>('.theme-toggle');

  if (document.documentElement.classList.contains('dark')) {
    toggleButtons.forEach((btn) => btn.classList.add('theme-toggle--toggled'));
  }

  function toggleTheme() {
    const goingDark = !document.documentElement.classList.contains('dark');
    if (!prefersReducedMotion) {
      document.documentElement.classList.add('theme-transitioning');
      void document.documentElement.offsetHeight;
    }
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', goingDark ? 'dark' : 'light');
    toggleButtons.forEach((btn) => btn.classList.toggle('theme-toggle--toggled'));
    if (!prefersReducedMotion) {
      setTimeout(() => document.documentElement.classList.remove('theme-transitioning'), 650);
    }
  }
  document.getElementById('wiki-theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('wiki-theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
