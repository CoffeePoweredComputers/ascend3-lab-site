---
/**
 * KappaCalculator — two coders, one binary code (present/absent). Edit the 2×2
 * counts (or load a preset) and watch observed agreement, expected agreement,
 * and Cohen's κ update. The "Kappa paradox" preset shows high agreement with a
 * low κ — the cue to consider Gwet's AC1 instead.
 */
---

<div class="wiki-kappa" data-kappa>
  <div class="wiki-kappa__presets">
    <button type="button" class="wiki-kappa__preset" data-preset="40,8,7,45">Balanced</button>
    <button type="button" class="wiki-kappa__preset" data-preset="85,5,8,2">Kappa paradox (skewed)</button>
    <button type="button" class="wiki-kappa__preset" data-preset="25,0,0,25">Perfect agreement</button>
  </div>

  <div class="wiki-kappa__layout">
    <table class="wiki-kappa__matrix">
      <thead>
        <tr>
          <th></th>
          <th>B: present</th>
          <th>B: absent</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>A: present</th>
          <td><input type="number" min="0" data-cell="a" value="40" aria-label="Both present" /></td>
          <td><input type="number" min="0" data-cell="b" value="8" aria-label="A present, B absent" /></td>
        </tr>
        <tr>
          <th>A: absent</th>
          <td><input type="number" min="0" data-cell="c" value="7" aria-label="A absent, B present" /></td>
          <td><input type="number" min="0" data-cell="d" value="45" aria-label="Both absent" /></td>
        </tr>
      </tbody>
    </table>

    <div class="wiki-kappa__out">
      <div class="wiki-kappa__stat" data-row="n"><span>Segments (n)</span><span class="wiki-kappa__stat-val" data-out="n">—</span></div>
      <div class="wiki-kappa__stat" data-row="po"><span>Observed agreement (p<sub>o</sub>)</span><span class="wiki-kappa__stat-val" data-out="po">—</span></div>
      <div class="wiki-kappa__stat" data-row="pe"><span>Expected by chance (p<sub>e</sub>)</span><span class="wiki-kappa__stat-val" data-out="pe">—</span></div>
      <div class="wiki-kappa__stat" data-row="kappa"><span>Cohen's κ</span><span class="wiki-kappa__stat-val" data-out="kappa">—</span></div>
      <div class="wiki-kappa__stat" data-row="ac1"><span>Gwet's AC1</span><span class="wiki-kappa__stat-val" data-out="ac1">—</span></div>
      <p class="wiki-kappa__verdict" data-out="verdict"></p>
    </div>
  </div>
</div>

<script>
  // Landis & Koch (1977) bands — explicitly arbitrary heuristics, not standards.
  function band(k: number): string {
    if (k < 0) return 'Poor (worse than chance)';
    if (k <= 0.20) return 'Slight';
    if (k <= 0.40) return 'Fair';
    if (k <= 0.60) return 'Moderate';
    if (k <= 0.80) return 'Substantial';
    return 'Almost perfect';
  }

  document.querySelectorAll<HTMLElement>('[data-kappa]').forEach((root) => {
    const cell = (k: string) => root.querySelector<HTMLInputElement>(`[data-cell="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const inputs = ['a', 'b', 'c', 'd'].map(cell);

    // Highlight the stat rows the verdict is talking about.
    function setFocus(rows: string[]) {
      root.querySelectorAll<HTMLElement>('[data-row]').forEach((el) => {
        el.classList.toggle('is-focus', rows.includes(el.dataset.row || ''));
      });
    }

    function recompute() {
      const a = +cell('a').value || 0;
      const b = +cell('b').value || 0;
      const c = +cell('c').value || 0;
      const d = +cell('d').value || 0;
      const n = a + b + c + d;

      if (n === 0) {
        out('n').textContent = '0';
        ['po', 'pe', 'kappa', 'ac1'].forEach((k) => (out(k).textContent = '—'));
        out('verdict').textContent = 'Enter some counts to compute κ.';
        setFocus([]);
        return;
      }

      const po = (a + d) / n;
      const pYes = ((a + b) / n) * ((a + c) / n); // both code "present" by chance
      const pNo = ((c + d) / n) * ((b + d) / n); // both code "absent" by chance
      const pe = pYes + pNo;
      const kappa = pe === 1 ? 1 : (po - pe) / (1 - pe);

      // Gwet's AC1 (2 categories): pe = 2·π(1−π), π = mean proportion coded "present"
      const pi = (2 * a + b + c) / (2 * n);
      const peG = 2 * pi * (1 - pi);
      const ac1 = peG === 1 ? 1 : (po - peG) / (1 - peG);

      out('n').textContent = String(n);
      out('po').textContent = `${(po * 100).toFixed(1)}%`;
      out('pe').textContent = `${(pe * 100).toFixed(1)}%`;
      out('kappa').textContent = kappa.toFixed(2);
      out('ac1').textContent = ac1.toFixed(2);

      const paradox = po >= 0.8 && kappa < 0.4;
      out('verdict').innerHTML = paradox
        ? `κ = ${kappa.toFixed(2)} (${band(kappa)}) — yet you agree on ${(po * 100).toFixed(0)}% of segments. This is the <strong>kappa paradox</strong>: skewed marginals deflate κ. Here <strong>Gwet's AC1 = ${ac1.toFixed(2)}</strong> resists that distortion and is the fairer summary.`
        : `κ = ${kappa.toFixed(2)} — "${band(kappa)}" on the Landis &amp; Koch scale (a rough heuristic, not a standard). Gwet's AC1 = ${ac1.toFixed(2)}.`;

      // The paradox verdict contrasts high observed agreement against κ, so spotlight pₒ too.
      setFocus(paradox ? ['po', 'kappa', 'ac1'] : ['kappa', 'ac1']);
    }

    inputs.forEach((inp) => inp.addEventListener('input', recompute));
    root.querySelectorAll<HTMLButtonElement>('.wiki-kappa__preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const [a, b, c, d] = (btn.dataset.preset || '').split(',');
        cell('a').value = a; cell('b').value = b; cell('c').value = c; cell('d').value = d;
        recompute();
      });
    });

    recompute();
  });
</script>
