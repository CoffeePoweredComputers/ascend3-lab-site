---
/**
 * PersonCard — Compact lab member profile card
 *
 * Static bio line. The name links to this person's profile page when they have
 * one (`profileHref`), otherwise to their external website — a person with both
 * gets the profile on the name and their site as a separate line, so the
 * internal page is never buried.
 * Collaborators use secondary accent.
 */

import ProfileImage from './ProfileImage.astro';

interface Props {
  name: string;
  role: string;
  photo?: string;
  bio?: string;
  website?: string;
  institution?: string;
  isCollaborator?: boolean;
  /** Internal profile URL, when this person has a page under /people/. */
  profileHref?: string;
}

const { name, role, photo, bio, website, institution, isCollaborator = false, profileHref } = Astro.props;
const initials = name.split(' ').map(n => n[0]).join('').slice(0, 2);

const hostLabel = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return 'website';
  }
};
---

<div class:list={[
  'card p-3 flex flex-col items-center text-center',
  isCollaborator ? 'hover:border-secondary hover:shadow-[0_4px_24px_rgba(22,101,52,0.08)]' : ''
]}>
  <!-- Photo -->
  {photo ? (
    <ProfileImage
      photo={photo}
      name={name}
      size={56}
      sizeClass="w-14 h-14"
      class:list={[
        'mb-3 ring-1 ring-offset-1 ring-offset-surface-base',
        isCollaborator ? 'ring-secondary/50' : 'ring-primary/50'
      ]}
    />
  ) : (
    <div class:list={[
      'w-14 h-14 rounded-full mb-3 flex items-center justify-center font-heading font-bold text-base ring-1 ring-offset-1 ring-offset-surface-base',
      isCollaborator
        ? 'bg-secondary/10 text-secondary ring-secondary/50'
        : 'bg-primary/10 text-primary ring-primary/50'
    ]}>
      {initials}
    </div>
  )}

  <!-- Name (links to the profile page, else the external website) -->
  <h3 class="font-heading font-semibold text-text text-base">
    {profileHref ? (
      <a
        href={profileHref}
        class="no-underline text-text hover:text-primary transition-colors"
      >
        {name}
      </a>
    ) : website ? (
      <a
        href={website}
        class="no-underline text-text hover:text-primary transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        {name} <span class="text-text-muted text-xs" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in new tab)</span>
      </a>
    ) : name}
  </h3>

  <!-- Role -->
  <p class:list={[
    'font-mono text-xs mt-1',
    isCollaborator ? 'text-secondary' : 'text-primary'
  ]}>
    {role}
  </p>

  <!-- Institution (for collaborators) -->
  {institution && (
    <p class="text-text-muted text-xs mt-0.5">{institution}</p>
  )}

  <!-- External site — only when the name is already taken by the profile link -->
  {profileHref && website && (
    <a
      href={website}
      class="font-mono text-xs text-text-muted hover:text-primary no-underline transition-colors mt-1"
      target="_blank"
      rel="noopener noreferrer"
    >
      {hostLabel(website)} <span aria-hidden="true">↗</span>
      <span class="sr-only">(opens in new tab)</span>
    </a>
  )}

  <!-- Bio -->
  {bio && (
    <p class="text-text-muted text-sm mt-2 leading-relaxed">{bio}</p>
  )}

</div>
