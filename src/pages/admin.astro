---
/**
 * /admin — the site admin dashboard. Wiki-specific admin (report triage,
 * publishing) lives at /wiki/admin.
 *
 * Static page, client-gated to admins (real enforcement is firestore.rules).
 * Three tabs:
 *  - Members: approve pending lab members, promote/revoke admin, remove.
 *  - Interest: "Express interest" submissions from /undergrad.
 *  - News: edit the homepage news feed, committed straight to master
 *    (src/data/news.json); autodeploy rebuilds within ~5 min.
 * noindex — gated app shell.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/wiki.css';

const configured = Boolean(
  import.meta.env.PUBLIC_FIREBASE_API_KEY && import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
);

const NAV_ROUTES = [
  { href: '/', label: 'ASCEND Home', icon: '🏔' },
  { href: '/wiki', label: 'Lab Wiki', icon: '📚' },
];
---

<BaseLayout title="Admin" description="ASCEND Lab admin dashboard." noindex>
  <Navigation slot="nav" links={[]} logoHref="/" routeLinks={NAV_ROUTES} />
  <section class="section">
    <div class="container max-w-4xl">
      <p class="font-mono text-sm text-primary mb-2">&gt; admin</p>
      <h1 class="font-heading text-3xl lg:text-4xl font-bold mb-2">Admin dashboard</h1>
      <p class="text-text-muted mb-8">
        Manage members, review interest, and post news. Wiki reports and publishing live at
        <a class="text-primary hover:underline" href="/wiki/admin">Wiki admin →</a>.
      </p>

      <div class="wiki-review" data-state={configured ? 'loading' : 'notconfigured'}>
        <p class="wiki-review__msg wiki-review__loading">Loading…</p>
        <p class="wiki-review__msg wiki-review__signedout">Sign in from the sidebar with an admin account to view this.</p>
        <p class="wiki-review__msg wiki-review__denied">This page is for admins only.</p>
        <p class="wiki-review__msg wiki-review__notconfigured">Reporting isn't set up yet.</p>
        <p class="wiki-review__msg wiki-review__error">Couldn't load members — check your connection and reload.</p>

        <div class="wiki-review__panel">
          <div class="wiki-review__tabs" role="tablist">
            <button type="button" class="is-active" data-tab="members">
              Members <span class="wiki-review__pill" data-pending-badge hidden></span>
            </button>
            <button type="button" data-tab="interest">
              Interest <span class="wiki-review__pill" data-interest-badge hidden></span>
            </button>
            <button type="button" data-tab="news">
              News <span class="wiki-review__pill" data-news-badge hidden></span>
            </button>
          </div>

          <!-- Members -->
          <div data-view="members">
            <h2 class="wiki-review__subhead">Pending approval</h2>
            <ul class="wiki-review__list" data-members-pending role="list"></ul>
            <p class="wiki-review__empty" data-members-nopending hidden>No one's waiting for approval.</p>

            <h2 class="wiki-review__subhead">Members</h2>
            <ul class="wiki-review__list" data-members-active role="list"></ul>
          </div>

          <!-- Interest ("Express interest" submissions from /undergrad) -->
          <div data-view="interest" hidden>
            <ul class="wiki-review__list" data-interest-list role="list"></ul>
            <p class="wiki-review__empty" data-interest-empty hidden>No one's expressed interest yet.</p>
          </div>

          <!-- News (edits src/data/news.json on master via a PR) -->
          <div data-view="news" hidden>
            <p class="wiki-review__newsnote" data-news-loading>Loading current news from GitHub…</p>
            <p class="wiki-review__empty" data-news-loaderr hidden>
              Couldn't load news.json from GitHub.
              <button type="button" data-news-retry>Retry</button>
            </p>

            <div data-news-editor hidden>
              <h2 class="wiki-review__subhead" data-news-formhead>Add an item</h2>
              <form class="wiki-review__newsform" data-news-form>
                <div class="wiki-review__newsrow">
                  <label>Date <input type="date" name="date" required /></label>
                  <label>Type
                    <select name="type">
                      <option value="publication">publication</option>
                      <option value="talk">talk</option>
                      <option value="grant">grant</option>
                      <option value="general">general</option>
                    </select>
                  </label>
                </div>
                <label>Title <input type="text" name="title" required maxlength="120" /></label>
                <label>Description <textarea name="description" rows="3" required></textarea></label>
                <label>Links — one per line, as <code>Label | https://url</code>
                  <textarea name="links" rows="2" placeholder="CHCI | https://hci.icat.vt.edu/"></textarea>
                </label>
                <div class="wiki-review__resolveactions">
                  <button type="button" data-news-cancel hidden>Cancel edit</button>
                  <button type="submit" data-news-submit>Add item</button>
                </div>
              </form>

              <h2 class="wiki-review__subhead">Items</h2>
              <ul class="wiki-review__list" data-news-list role="list"></ul>

              <div class="wiki-review__newsbar" data-news-bar hidden>
                <span class="wiki-review__count" data-news-summary></span>
                <button type="button" data-news-discard>Discard changes</button>
                <button type="button" class="wiki-review__prbtn" data-news-pr>Publish</button>
              </div>
              <p class="wiki-review__newsnote">
                Publishing commits <code>src/data/news.json</code> straight to <code>master</code> —
                no review step. The site rebuilds automatically, so the item is live within about
                five minutes.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import type { Annotation, Member, Interest, InterestStatus } from '@lib/annotate/types';
  import { toast } from '@lib/annotate/toast';

  const box = document.querySelector<HTMLElement>('.wiki-review');
  const pendingEl = document.querySelector<HTMLElement>('[data-members-pending]');
  const noPendingEl = document.querySelector<HTMLElement>('[data-members-nopending]');
  const activeEl = document.querySelector<HTMLElement>('[data-members-active]');
  const pendingBadge = document.querySelector<HTMLElement>('[data-pending-badge]');
  const interestEl = document.querySelector<HTMLElement>('[data-interest-list]');
  const interestEmptyEl = document.querySelector<HTMLElement>('[data-interest-empty]');
  const interestBadge = document.querySelector<HTMLElement>('[data-interest-badge]');

  if (box && pendingEl && activeEl && interestEl && interestEmptyEl && box.dataset.state !== 'notconfigured') {
    (async () => {
      const { onUser, getMember, isAdmin } = await import('@lib/annotate/auth');
      const { watchMembers, approveMember, removeMember, setMemberRole, setMemberEditor } = await import('@lib/annotate/members');
      const { watchAllInterest, setInterestStatus } = await import('@lib/annotate/interest');

      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
      const fmtDate = (ts: Annotation['createdAt']) =>
        ts && typeof ts.toDate === 'function' ? ts.toDate().toLocaleDateString() : '';
      const errMsg = (e: unknown) => (e instanceof Error ? e.message : 'unknown error');

      let myUid = '';

      // ── Tabs ──
      box.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) =>
        tab.addEventListener('click', () => {
          const name = tab.dataset.tab;
          box.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.classList.toggle('is-active', t === tab));
          box.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== name));
        }),
      );

      // ── Members ──
      const levelLabel = (m: Member) =>
        m.level ? m.level.charAt(0).toUpperCase() + m.level.slice(1) : '';

      const pendingCard = (m: Member) => `<li class="wiki-review__member" data-uid="${esc(m.uid)}">
        <div class="wiki-review__memberinfo">
          <span class="wiki-review__membername">${esc(m.displayName || m.email)}</span>
          <span class="wiki-review__membermeta">${esc(m.email)} · ${esc(fmtDate(m.createdAt))}${m.level ? ` · ${esc(levelLabel(m))}` : ''}</span>
        </div>
        <div class="wiki-review__actions">
          <button type="button" data-mact="approve" class="wiki-review__approve">Approve</button>
          <button type="button" data-mact="deny">Deny</button>
        </div>
      </li>`;

      const activeRow = (m: Member) => {
        const self = m.uid === myUid;
        const admin = m.role === 'admin';
        const editor = m.editor === true;
        const roleBtn = self
          ? ''
          : admin
            ? `<button type="button" data-mact="revoke">Revoke admin</button>`
            : `<button type="button" data-mact="makeadmin">Make admin</button>`;
        // Admins are implicitly editors, so the editor toggle only applies to
        // non-admin members. Granting it still requires a GitHub-collaborator add.
        const editorBtn = self || admin
          ? ''
          : editor
            ? `<button type="button" data-mact="editoroff">Revoke editor</button>`
            : `<button type="button" data-mact="editoron">Make editor</button>`;
        const removeBtn = self ? '' : `<button type="button" data-mact="remove">Remove</button>`;
        const badge = admin ? 'admin' : editor ? 'editor' : 'member';
        return `<li class="wiki-review__member" data-uid="${esc(m.uid)}">
          <div class="wiki-review__memberinfo">
            <span class="wiki-review__membername">${esc(m.displayName || m.email)}${self ? ' <em>(you)</em>' : ''}</span>
            <span class="wiki-review__membermeta">${esc(m.email)}${m.level ? ` · ${esc(levelLabel(m))}` : ''}</span>
          </div>
          <span class="wiki-review__rolebadge" data-admin="${admin}" data-editor="${editor}">${badge}</span>
          <div class="wiki-review__actions">${roleBtn}${editorBtn}${removeBtn}</div>
        </li>`;
      };

      let lastMembers: Member[] = [];
      const renderMembers = (members: Member[]) => {
        lastMembers = members;
        const pending = members.filter((m) => m.status === 'pending');
        const active = members.filter((m) => m.status === 'member');
        pendingEl.innerHTML = pending.map(pendingCard).join('');
        noPendingEl!.hidden = pending.length > 0;
        activeEl.innerHTML = active.map(activeRow).join('');
        if (pendingBadge) {
          pendingBadge.textContent = String(pending.length);
          pendingBadge.hidden = pending.length === 0;
        }
      };

      const memberAction = (container: HTMLElement) => {
        container.addEventListener('click', async (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-mact]');
          if (!btn) return;
          const uid = btn.closest<HTMLElement>('.wiki-review__member')?.dataset.uid;
          if (!uid) return;
          const act = btn.dataset.mact;

          // Inline confirm (replaces native confirm()) for destructive removal:
          // swap the row's actions for a Yes/Cancel prompt.
          if (act === 'deny' || act === 'remove') {
            const actions = btn.closest<HTMLElement>('.wiki-review__actions');
            if (actions) {
              actions.innerHTML =
                `<span class="wiki-review__confirmtext">Remove this member?</span>` +
                `<button type="button" data-mact="confirm-yes" class="wiki-review__danger">Yes, remove</button>` +
                `<button type="button" data-mact="confirm-no">Cancel</button>`;
            }
            return;
          }
          if (act === 'confirm-no') { renderMembers(lastMembers); return; }

          btn.setAttribute('disabled', '');
          try {
            if (act === 'approve') { await approveMember(uid); toast('Member approved.', 'success'); }
            else if (act === 'confirm-yes') { await removeMember(uid); toast('Member removed.'); }
            else if (act === 'makeadmin') { await setMemberRole(uid, 'admin'); toast('Promoted to admin.', 'success'); }
            else if (act === 'revoke') { await setMemberRole(uid, 'member'); toast('Admin revoked.'); }
            else if (act === 'editoron') { await setMemberEditor(uid, true); toast('Editor access granted — remember to add them as a GitHub collaborator.', 'success'); }
            else if (act === 'editoroff') { await setMemberEditor(uid, false); toast('Editor access revoked.'); }
            // On success the members snapshot re-renders the row; no re-enable needed.
          } catch (err) {
            toast(`Couldn't update member: ${errMsg(err)}`, 'error');
            renderMembers(lastMembers); // restore the row (undo any confirm swap)
          }
        });
      };
      memberAction(pendingEl);
      memberAction(activeEl);

      // ── Interest ("Express interest" submissions) ──
      const INTEREST_STATUS_LABEL: Record<InterestStatus, string> = {
        new: 'New', contacted: 'Contacted', closed: 'Closed',
      };
      const interestActions = (i: Interest): string => {
        if (i.status === 'new') return `<button type="button" data-iact="contacted">Mark contacted</button><button type="button" data-iact="closed">Close</button>`;
        if (i.status === 'contacted') return `<button type="button" data-iact="closed">Close</button><button type="button" data-iact="new">Reopen</button>`;
        return `<button type="button" data-iact="new">Reopen</button>`;
      };
      const interestCard = (i: Interest) => `<li class="wiki-review__item" data-id="${esc(i.id)}">
        <div class="wiki-review__row">
          <span class="wiki-review__type">${esc(i.projectTitle)}</span>
          <span class="wiki-review__status">${esc(INTEREST_STATUS_LABEL[i.status] ?? i.status)}</span>
        </div>
        ${i.note ? `<p class="wiki-review__note">${esc(i.note)}</p>` : ''}
        <p class="wiki-review__meta">${esc(i.authorName || i.authorEmail)} · ${esc(fmtDate(i.createdAt))} · <a href="mailto:${esc(i.authorEmail)}">${esc(i.authorEmail)}</a></p>
        <div class="wiki-review__actions">${interestActions(i)}</div>
      </li>`;

      let allInterest: Interest[] = [];
      const renderInterest = (items: Interest[]) => {
        allInterest = items;
        interestEl.innerHTML = items.map(interestCard).join('');
        interestEmptyEl.hidden = items.length > 0;
        const newCount = items.filter((i) => i.status === 'new').length;
        if (interestBadge) {
          interestBadge.textContent = String(newCount);
          interestBadge.hidden = newCount === 0;
        }
      };

      interestEl.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-iact]');
        if (!btn) return;
        const id = btn.closest<HTMLElement>('.wiki-review__item')?.dataset.id;
        const status = btn.dataset.iact as InterestStatus | undefined;
        if (!id || !status) return;
        btn.setAttribute('disabled', '');
        try {
          await setInterestStatus(id, status);
        } catch (err) {
          toast(`Couldn't update: ${errMsg(err)}`, 'error');
          btn.removeAttribute('disabled');
        }
      });

      // ── News (edits src/data/news.json on master via a PR) ──
      interface NewsLink { text: string; url: string }
      interface NewsItem { date: string; type: string; title: string; description: string; links: NewsLink[] }

      const newsLoadingEl = box.querySelector<HTMLElement>('[data-news-loading]')!;
      const newsLoadErrEl = box.querySelector<HTMLElement>('[data-news-loaderr]')!;
      const newsEditorEl = box.querySelector<HTMLElement>('[data-news-editor]')!;
      const newsListEl = box.querySelector<HTMLElement>('[data-news-list]')!;
      const newsForm = box.querySelector<HTMLFormElement>('[data-news-form]')!;
      const newsFormHead = box.querySelector<HTMLElement>('[data-news-formhead]')!;
      const newsSubmitBtn = box.querySelector<HTMLButtonElement>('[data-news-submit]')!;
      const newsCancelBtn = box.querySelector<HTMLButtonElement>('[data-news-cancel]')!;
      const newsBar = box.querySelector<HTMLElement>('[data-news-bar]')!;
      const newsSummary = box.querySelector<HTMLElement>('[data-news-summary]')!;
      const newsBadge = box.querySelector<HTMLElement>('[data-news-badge]');
      const newsPrBtn = box.querySelector<HTMLButtonElement>('[data-news-pr]')!;
      const newsDiscardBtn = box.querySelector<HTMLButtonElement>('[data-news-discard]')!;
      const newsRetryBtn = box.querySelector<HTMLButtonElement>('[data-news-retry]')!;

      let newsBaseSha: string | undefined;
      let newsWorking: NewsItem[] = [];
      let newsChanges: string[] = [];
      let newsEditing: number | null = null;
      let newsLoaded = false;

      const newsDirtyUi = () => {
        newsBar.hidden = newsChanges.length === 0;
        newsSummary.textContent = `${newsChanges.length} pending change${newsChanges.length === 1 ? '' : 's'}`;
        if (newsBadge) {
          newsBadge.textContent = String(newsChanges.length);
          newsBadge.hidden = newsChanges.length === 0;
        }
      };

      const newsRow = (n: NewsItem, i: number) => `<li class="wiki-review__item" data-i="${i}">
        <div class="wiki-review__row">
          <span class="wiki-review__type">${esc(n.date)} · ${esc(n.type)}</span>
          <div class="wiki-review__actions">
            <button type="button" data-nact="edit">Edit</button>
            <button type="button" data-nact="remove">Remove</button>
          </div>
        </div>
        <p class="wiki-review__note">${esc(n.title)}</p>
        <p class="wiki-review__meta">${esc(n.description.length > 140 ? `${n.description.slice(0, 140)}…` : n.description)}${n.links.length ? ` · ${n.links.length} link${n.links.length === 1 ? '' : 's'}` : ''}</p>
      </li>`;

      const renderNews = () => {
        newsListEl.innerHTML = newsWorking.map(newsRow).join('');
        newsDirtyUi();
      };

      const newsResetForm = () => {
        newsForm.reset();
        (newsForm.elements.namedItem('date') as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
        newsEditing = null;
        newsFormHead.textContent = 'Add an item';
        newsSubmitBtn.textContent = 'Add item';
        newsCancelBtn.hidden = true;
      };

      const parseLinks = (s: string): NewsLink[] =>
        s.split('\n').map((l) => l.trim()).filter(Boolean).map((l) => {
          const at = l.indexOf('|');
          if (at < 1) throw new Error(`Link line needs “Label | URL”: “${l}”`);
          const text = l.slice(0, at).trim();
          const url = l.slice(at + 1).trim();
          if (!/^https?:\/\//.test(url)) throw new Error(`Link URL must start with http(s):// — “${url}”`);
          return { text, url };
        });

      const loadNews = async () => {
        newsLoadingEl.hidden = false;
        newsLoadErrEl.hidden = true;
        newsEditorEl.hidden = true;
        try {
          const { readFileFromMaster, NEWS_JSON } = await import('@lib/annotate/pr');
          const file = await readFileFromMaster(NEWS_JSON);
          if (!file) throw new Error(`${NEWS_JSON} not found on master`);
          newsBaseSha = file.sha;
          newsWorking = JSON.parse(file.text) as NewsItem[];
          newsChanges = [];
          newsLoaded = true;
          newsLoadingEl.hidden = true;
          newsEditorEl.hidden = false;
          newsResetForm();
          renderNews();
        } catch (err) {
          newsLoadingEl.hidden = true;
          newsLoadErrEl.hidden = false;
          toast(`Couldn't load news: ${errMsg(err)}`, 'error');
        }
      };
      newsRetryBtn.addEventListener('click', () => void loadNews());
      // Lazy: fetch news.json from GitHub only when the tab is first opened
      // (unauthenticated read — spends the 60/hr per-IP budget sparingly).
      box.querySelector<HTMLElement>('[data-tab="news"]')?.addEventListener('click', () => {
        if (!newsLoaded) void loadNews();
      });

      newsForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(newsForm);
        try {
          const item: NewsItem = {
            date: ((fd.get('date') as string) || '').trim(),
            type: (fd.get('type') as string) || 'general',
            title: ((fd.get('title') as string) || '').trim(),
            description: ((fd.get('description') as string) || '').trim(),
            links: parseLinks((fd.get('links') as string) || ''),
          };
          if (!item.date || !item.title || !item.description) {
            throw new Error('Date, title, and description are required.');
          }
          if (newsEditing !== null) {
            newsWorking[newsEditing] = item;
            newsChanges.push(`Edit: ${item.title}`);
          } else {
            newsWorking.unshift(item);
            newsChanges.push(`Add: ${item.title}`);
          }
          // Keep the file's newest-first convention (stable for equal dates).
          newsWorking.sort((a, b) => b.date.localeCompare(a.date));
          newsResetForm();
          renderNews();
        } catch (err) {
          toast(errMsg(err), 'error');
        }
      });

      newsCancelBtn.addEventListener('click', () => newsResetForm());

      newsListEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-nact]');
        if (!btn) return;
        const i = Number(btn.closest<HTMLElement>('.wiki-review__item')?.dataset.i);
        if (Number.isNaN(i) || !newsWorking[i]) return;
        if (btn.dataset.nact === 'remove') {
          newsChanges.push(`Remove: ${newsWorking[i].title}`);
          newsWorking.splice(i, 1);
          if (newsEditing === i) newsResetForm();
          renderNews();
          return;
        }
        // edit: load the item into the form
        const n = newsWorking[i];
        newsEditing = i;
        (newsForm.elements.namedItem('date') as HTMLInputElement).value = n.date;
        (newsForm.elements.namedItem('type') as HTMLSelectElement).value = n.type;
        (newsForm.elements.namedItem('title') as HTMLInputElement).value = n.title;
        (newsForm.elements.namedItem('description') as HTMLTextAreaElement).value = n.description;
        (newsForm.elements.namedItem('links') as HTMLTextAreaElement).value =
          n.links.map((l) => `${l.text} | ${l.url}`).join('\n');
        newsFormHead.textContent = `Editing: ${n.title}`;
        newsSubmitBtn.textContent = 'Save changes';
        newsCancelBtn.hidden = false;
        newsFormHead.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      newsDiscardBtn.addEventListener('click', () => void loadNews());

      newsPrBtn.addEventListener('click', async () => {
        if (newsChanges.length === 0) return;
        newsPrBtn.disabled = true;
        const label = newsPrBtn.textContent;
        newsPrBtn.textContent = 'Publishing…';
        try {
          const { commitNewsToMaster } = await import('@lib/annotate/pr');
          if (!newsBaseSha) throw new Error('News never finished loading — reload the tab.');
          const summary =
            newsChanges.length === 1 ? newsChanges[0] : `${newsChanges.length} updates`;
          const done = await commitNewsToMaster({
            content: `${JSON.stringify(newsWorking, null, 2)}\n`,
            baseSha: newsBaseSha,
            message: [
              `News: ${summary}`,
              '',
              ...newsChanges.map((c) => `- ${c}`),
              '',
              'Published from the admin dashboard.',
            ].join('\n'),
          });
          toast('Published — live in about 5 minutes.', 'success', {
            href: done.url,
            linkText: `${done.sha.slice(0, 7)} ↗`,
          });
          // Re-read master so the next edit this session bases off the new sha.
          await loadNews();
        } catch (err) {
          toast(`Couldn't publish: ${errMsg(err)}`, 'error');
        } finally {
          newsPrBtn.disabled = false;
          newsPrBtn.textContent = label;
        }
      });

      // ── Gate + subscribe ──
      let unsubMembers: (() => void) | null = null;
      let unsubInterest: (() => void) | null = null;
      const stop = () => {
        unsubMembers?.(); unsubInterest?.();
        unsubMembers = unsubInterest = null;
      };

      onUser(async (user) => {
        if (!user) { box.dataset.state = 'signedout'; stop(); return; }
        const member = await getMember(user.uid);
        if (!isAdmin(member)) { box.dataset.state = 'denied'; stop(); return; }
        myUid = user.uid;
        box.dataset.state = 'ready';
        stop();
        unsubMembers = watchMembers(
          renderMembers,
          (err) => { box.dataset.state = 'error'; toast(`Couldn't load members: ${errMsg(err)}`, 'error'); },
        );
        unsubInterest = watchAllInterest(
          renderInterest,
          (err) => { toast(`Couldn't load interest submissions: ${errMsg(err)}`, 'error'); },
        );
      });
    })();
  }
</script>
