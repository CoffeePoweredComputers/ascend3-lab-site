---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { getWikiNav, lessonHref } from '../../lib/wiki';

const nav = await getWikiNav();
---

<WikiLayout title="Lab Wiki" description="The ASCEND Lab's interactive handbook — IRB, qualitative and quantitative analysis, and more.">
  <div class="container py-12 lg:py-16">
    <header class="max-w-2xl mb-10">
      <p class="font-mono text-sm text-primary mb-2">&gt; lab handbook</p>
      <h1 class="font-heading text-3xl lg:text-4xl font-bold mb-3">Lab Wiki</h1>
      <p class="text-text-muted text-lg">
        Interactive walkthroughs for the methods and processes we use. Work through a
        module top to bottom, or jump to the lesson you need.
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2">
      {nav.map((m) => {
        if (m.underConstruction) {
          return (
            <div class="card p-6 flex flex-col gap-3 opacity-70 cursor-default" data-mod={m.slug}>
              <div class="flex items-center gap-3">
                <span class="text-2xl" aria-hidden="true">{m.icon}</span>
                <h2 class="font-heading text-lg font-bold text-text">{m.title}</h2>
              </div>
              <p class="text-sm text-text-muted flex-grow">{m.blurb}</p>
              <div class="pt-2">
                <span class="inline-flex items-center gap-1.5 text-xs font-mono px-2 py-1 rounded-md bg-surface text-text-muted border border-border">🚧 Under construction</span>
              </div>
            </div>
          );
        }
        const first = m.lessons[0];
        const href = first ? lessonHref(first) : '/wiki';
        return (
          <a href={href} class="card no-underline p-6 flex flex-col gap-3 group" data-mod={m.slug} data-mod-total={m.lessons.length}>
            <div class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">{m.icon}</span>
              <h2 class="font-heading text-lg font-bold text-text group-hover:text-primary transition-colors">{m.title}</h2>
            </div>
            <p class="text-sm text-text-muted flex-grow">{m.blurb}</p>
            <div class="flex items-center justify-between text-xs font-mono text-text-muted pt-2">
              <span>{m.lessons.length} {m.lessons.length === 1 ? 'lesson' : 'lessons'}</span>
              <span data-mod-count>0/{m.lessons.length} done</span>
            </div>
            <div class="wiki-mod__bar" aria-hidden="true"><span data-mod-bar style="width:0%"></span></div>
          </a>
        );
      })}
    </div>
  </div>

  <script>
    // Reflect saved progress on the landing cards.
    const STORAGE_KEY = 'wiki-progress';
    function readProgress(): string[] {
      try { const raw = localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : []; }
      catch { return []; }
    }
    function paint() {
      const done = new Set(readProgress());
      document.querySelectorAll<HTMLElement>('[data-mod]').forEach((card) => {
        const total = Number(card.dataset.modTotal) || 0;
        // The landing cards don't list lessons, so derive completion from ids that
        // start with "<slug>/" — entry ids are "<module>/<lesson>".
        const slug = card.dataset.mod;
        const completed = Array.from(done).filter((id) => id.startsWith(slug + '/')).length;
        const bar = card.querySelector<HTMLElement>('[data-mod-bar]');
        const count = card.querySelector<HTMLElement>('[data-mod-count]');
        if (bar) bar.style.width = total ? `${(completed / total) * 100}%` : '0%';
        if (count) count.textContent = `${completed}/${total} done`;
      });
    }
    paint();
    window.addEventListener('wiki-progress-change', paint);
    window.addEventListener('storage', (e) => { if (e.key === STORAGE_KEY) paint(); });
  </script>
</WikiLayout>
