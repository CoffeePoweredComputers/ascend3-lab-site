# The lab tools gate. Built and run by tools/_lib/deploy.mjs like any tool,
# but on the fixed port 8790 nginx's auth_request points at, with status.json
# mounted read-only and ~/.config/ascend-tools/_gate.env as its environment.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.mjs ./
ENV PORT=8080
EXPOSE 8080
USER node
CMD ["node", "server.mjs"]
